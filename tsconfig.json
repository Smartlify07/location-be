{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"rootDir": "./src",
		"outDir": "./dist",

		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,

		"paths": {
			"@/*": ["./src/*"],
			"@controllers/*": ["./src/controllers/*"],
			"@routes/*": ["./src/routes/*"],
			"@db/*": ["./src/db/*"],
			"@utils/*": ["./src/utils/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules"]
}
